rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      // Allow reading user list for login uniqueness check during registration
      allow read: if true;
      // Allow creating own document right after registration, updating only own doc
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }
    match /friend_requests/{reqId} {
      allow list: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow get: if request.auth != null && (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    
    match /room_invites/{inviteId} {
      allow list: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow get: if request.auth != null && (resource == null || resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
